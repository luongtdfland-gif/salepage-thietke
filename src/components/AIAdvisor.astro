---
// AI Advisor floating chat widget
// Uses vanilla JS to call /api/advisor endpoint
---

<div id="chat-widget" class="chat-widget" id="tu-van">
  <!-- Chat panel -->
  <div id="chat-panel" class="chat-panel" role="dialog" aria-label="AI Tư Vấn Thiết Kế" aria-hidden="true">
    <!-- Panel header -->
    <div style="
      padding: 16px 20px;
      background: var(--c-text);
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    ">
      <div style="
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--c-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      ">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <div style="font-size: 14px; font-weight: 600; color: var(--c-white); line-height: 1.2;">
          AI Tư Vấn Thiết Kế
        </div>
        <div style="font-size: 11px; color: var(--c-accent); margin-top: 1px;">
          Trực tuyến — phản hồi trong vài giây
        </div>
      </div>
      <button id="chat-close" aria-label="Đóng" style="
        background: none;
        border: none;
        color: #9A8E86;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: color 0.15s ease;
      " onmouseover="this.style.color='white'" onmouseout="this.style.color='#9A8E86'">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Messages area -->
    <div id="chat-messages" style="
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: var(--c-bg);
      min-height: 0;
    ">
      <!-- Welcome message -->
      <div class="msg-bubble msg-assistant" style="
        background: var(--c-white);
        border-radius: 12px 12px 12px 4px;
        padding: 12px 14px;
        font-size: 13px;
        line-height: 1.6;
        color: var(--c-text);
        box-shadow: var(--shadow-card);
        max-width: 90%;
      ">
        Xin chào! Tôi là AI tư vấn thiết kế nhà. Hãy cho tôi biết bạn cần thiết kế loại nhà gì,
        diện tích đất, số tầng và phong cách yêu thích — tôi sẽ gợi ý mẫu phù hợp nhất cho bạn.
      </div>
    </div>

    <!-- Typing indicator (hidden by default) -->
    <div id="chat-typing" style="
      padding: 8px 16px;
      display: none;
      align-items: center;
      gap: 6px;
      background: var(--c-bg);
    ">
      <div style="display: flex; gap: 3px; align-items: center;">
        <span style="
          width: 6px; height: 6px; border-radius: 50%;
          background: var(--c-muted);
          animation: typing-dot 1.4s infinite;
          animation-delay: 0s;
        "></span>
        <span style="
          width: 6px; height: 6px; border-radius: 50%;
          background: var(--c-muted);
          animation: typing-dot 1.4s infinite;
          animation-delay: 0.2s;
        "></span>
        <span style="
          width: 6px; height: 6px; border-radius: 50%;
          background: var(--c-muted);
          animation: typing-dot 1.4s infinite;
          animation-delay: 0.4s;
        "></span>
      </div>
      <span style="font-size: 12px; color: var(--c-muted);">Đang trả lời...</span>
    </div>

    <!-- Input area -->
    <div style="
      padding: 12px 16px;
      background: var(--c-white);
      border-top: 1px solid var(--c-border);
      display: flex;
      gap: 8px;
      align-items: flex-end;
      flex-shrink: 0;
    ">
      <textarea
        id="chat-input"
        placeholder="Nhập câu hỏi của bạn..."
        rows="1"
        style="
          flex: 1;
          border: 1.5px solid var(--c-border);
          border-radius: 8px;
          padding: 10px 12px;
          font-family: 'Be Vietnam Pro', sans-serif;
          font-size: 13px;
          color: var(--c-text);
          background: var(--c-bg);
          resize: none;
          outline: none;
          transition: border-color 0.15s ease;
          line-height: 1.5;
          max-height: 100px;
          overflow-y: auto;
        "
        onfocus="this.style.borderColor='var(--c-accent)'"
        onblur="this.style.borderColor='var(--c-border)'"
      ></textarea>
      <button id="chat-send" aria-label="Gửi" style="
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: var(--c-accent);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background 0.15s ease;
      " onmouseover="this.style.background='var(--c-accent-dark)'" onmouseout="this.style.background='var(--c-accent)'">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Floating button -->
  <button id="chat-toggle" class="chat-bubble-btn" aria-label="Mở tư vấn AI">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </button>

  <!-- Tooltip -->
  <div id="chat-tooltip" style="
    position: absolute;
    bottom: 70px;
    right: 0;
    background: var(--c-text);
    color: white;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    animation: tooltip-show 0.5s ease 2s forwards;
  ">
    Hỏi AI tư vấn ngay!
    <div style="
      position: absolute;
      bottom: -4px;
      right: 22px;
      width: 8px;
      height: 8px;
      background: var(--c-text);
      transform: rotate(45deg);
    "></div>
  </div>
</div>

<style>
  @keyframes typing-dot {
    0%, 60%, 100% { opacity: 0.3; transform: scale(1); }
    30% { opacity: 1; transform: scale(1.2); }
  }

  @keyframes tooltip-show {
    0% { opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>

<script>
  interface Message {
    role: 'user' | 'assistant';
    content: string;
  }

  const history: Message[] = [];
  let isLoading = false;

  const toggleBtn = document.getElementById('chat-toggle')!;
  const closeBtn = document.getElementById('chat-close')!;
  const panel = document.getElementById('chat-panel')!;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('chat-send')!;
  const messagesEl = document.getElementById('chat-messages')!;
  const typingEl = document.getElementById('chat-typing')!;

  let isOpen = false;

  function openChat() {
    isOpen = true;
    panel.classList.add('open');
    panel.setAttribute('aria-hidden', 'false');
    input.focus();

    // Change icon to X
    toggleBtn.innerHTML = `
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    `;
  }

  function closeChat() {
    isOpen = false;
    panel.classList.remove('open');
    panel.setAttribute('aria-hidden', 'true');

    // Change icon back to chat
    toggleBtn.innerHTML = `
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    `;
  }

  toggleBtn.addEventListener('click', () => {
    if (isOpen) closeChat();
    else openChat();
  });

  closeBtn.addEventListener('click', closeChat);

  // Close on outside click
  document.addEventListener('click', (e) => {
    const widget = document.getElementById('chat-widget')!;
    if (isOpen && !widget.contains(e.target as Node)) {
      closeChat();
    }
  });

  // Auto-resize textarea
  input.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 100) + 'px';
  });

  // Send on Enter (Shift+Enter for newline)
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  sendBtn.addEventListener('click', sendMessage);

  function appendMessage(role: 'user' | 'assistant', content: string) {
    const div = document.createElement('div');
    div.style.cssText = `
      max-width: 90%;
      padding: 12px 14px;
      font-size: 13px;
      line-height: 1.6;
      color: var(--c-text);
      box-shadow: 0 1px 4px rgba(120,80,20,0.06);
    `;

    if (role === 'user') {
      div.style.cssText += `
        background: var(--c-accent);
        color: white;
        border-radius: 12px 12px 4px 12px;
        align-self: flex-end;
        margin-left: auto;
      `;
    } else {
      div.style.cssText += `
        background: var(--c-white);
        border-radius: 12px 12px 12px 4px;
      `;
    }

    // Simple link detection in assistant messages
    div.innerHTML = content.replace(/\n/g, '<br>');

    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  async function sendMessage() {
    const text = input.value.trim();
    if (!text || isLoading) return;

    input.value = '';
    input.style.height = 'auto';
    isLoading = true;
    sendBtn.setAttribute('disabled', 'true');
    sendBtn.style.opacity = '0.5';

    // Append user message
    appendMessage('user', text);
    history.push({ role: 'user', content: text });

    // Show typing indicator
    typingEl.style.display = 'flex';
    messagesEl.scrollTop = messagesEl.scrollHeight;

    try {
      const res = await fetch('/api/advisor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history: history.slice(0, -1) }),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json() as { reply: string };
      typingEl.style.display = 'none';
      appendMessage('assistant', data.reply);
      history.push({ role: 'assistant', content: data.reply });
    } catch {
      typingEl.style.display = 'none';
      appendMessage('assistant', 'Xin lỗi, có lỗi xảy ra. Vui lòng thử lại sau.');
    } finally {
      isLoading = false;
      sendBtn.removeAttribute('disabled');
      sendBtn.style.opacity = '1';
    }
  }
</script>
