---
import type { Design } from '../lib/types';

export interface Props {
  design: Design;
}

const { design } = Astro.props;

const loaiLabels: Record<string, string> = {
  'nha-pho': 'Nhà Phố',
  'biet-thu': 'Biệt Thự',
  'chung-cu': 'Chung Cư',
  'nha-vuon': 'Nhà Vườn',
};

const phongCachLabels: Record<string, string> = {
  'hien-dai': 'Hiện Đại',
  'co-dien': 'Cổ Điển',
  'biet-thu-phap': 'Biệt Thự Pháp',
  'tan-co-dien': 'Tân Cổ Điển',
  'dia-trung-hai': 'Địa Trung Hải',
  'nhat-ban': 'Nhật Bản',
  'bac-au': 'Bắc Âu',
};

const formattedPrice = new Intl.NumberFormat('vi-VN', {
  style: 'currency',
  currency: 'VND',
  maximumFractionDigits: 0,
}).format(design.gia_ban_ho_so);

const loaiLabel = loaiLabels[design.loai] ?? design.loai;
const phongCachLabel = phongCachLabels[design.phong_cach] ?? design.phong_cach;

// Fallback image if anh_url is empty
const imageUrl = design.anh_url || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&h=450&fit=crop';
---

<article
  class="design-card"
  data-loai={design.loai}
  data-tang={design.so_tang}
  data-phong-cach={design.phong_cach}
>
  <!-- Image -->
  <a href={`/thiet-ke/${design.ma_mau}`} style="display: block; aspect-ratio: 4/3; overflow: hidden;">
    <img
      src={imageUrl}
      alt={`Mẫu thiết kế ${design.ten}`}
      width="600"
      height="450"
      loading="lazy"
      decoding="async"
      style="
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
      "
      onmouseover="this.style.transform='scale(1.04)'"
      onmouseout="this.style.transform='scale(1)'"
    />
  </a>

  <!-- Content -->
  <div style="padding: 20px; display: flex; flex-direction: column; flex: 1;">
    <!-- Badges row -->
    <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px;">
      <span class="badge badge-accent">{loaiLabel}</span>
      <span class="badge">{phongCachLabel}</span>
    </div>

    <!-- Design name -->
    <a
      href={`/thiet-ke/${design.ma_mau}`}
      style="text-decoration: none;"
    >
      <h3 style="
        font-family: 'Cormorant Garamond', serif;
        font-size: 19px;
        font-weight: 700;
        color: var(--c-text);
        margin: 0 0 12px;
        line-height: 1.3;
        transition: color 0.15s ease;
      " onmouseover="this.style.color='var(--c-accent-dark)'"
         onmouseout="this.style.color='var(--c-text)'">
        {design.ten}
      </h3>
    </a>

    <!-- Stats -->
    <div style="
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 16px;
      padding: 12px;
      background: var(--c-surface);
      border-radius: 8px;
    ">
      <div style="text-align: center;">
        <div style="font-size: 16px; font-weight: 700; color: var(--c-text); font-family: 'Cormorant Garamond', serif;">
          {design.dien_tich_dat}m²
        </div>
        <div style="font-size: 10px; color: var(--c-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px;">
          Diện Tích
        </div>
      </div>
      <div style="text-align: center; border-left: 1px solid var(--c-border); border-right: 1px solid var(--c-border);">
        <div style="font-size: 16px; font-weight: 700; color: var(--c-text); font-family: 'Cormorant Garamond', serif;">
          {design.so_tang} tầng
        </div>
        <div style="font-size: 10px; color: var(--c-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px;">
          Số Tầng
        </div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 16px; font-weight: 700; color: var(--c-text); font-family: 'Cormorant Garamond', serif;">
          {design.so_phong_ngu} PN
        </div>
        <div style="font-size: 10px; color: var(--c-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px;">
          Phòng Ngủ
        </div>
      </div>
    </div>

    <!-- Price -->
    <div style="
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin-bottom: 16px;
    ">
      <span style="font-size: 12px; color: var(--c-muted);">Hồ sơ thiết kế:</span>
      <span class="price" style="font-size: 20px;">{formattedPrice}</span>
    </div>

    <!-- CTA -->
    <a
      href={`/thiet-ke/${design.ma_mau}`}
      class="btn-secondary"
      style="width: 100%; text-align: center; margin-top: auto; box-sizing: border-box;"
    >
      Xem Chi Tiết
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
