# Google Sheets published CSV URL
# Go to File > Share > Publish to web > Select "Comma-separated values (.csv)" > Publish
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv

# PayOS credentials (https://payos.vn/docs)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Download link signing secret (generate with: openssl rand -hex 32)
DOWNLOAD_SECRET=your-random-32-char-secret-here

# Resend API key (https://resend.com)
RESEND_API_KEY=re_...

# Site URL (for generating download links in emails)
SITE_URL=https://your-domain.vn

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
